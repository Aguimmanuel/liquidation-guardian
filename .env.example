# ── Liquidation Guardian configuration ───────────────────────────────────────
# Copy to .env and adjust. Everything is optional — the app runs in SIM mode
# with live public market data out of the box, no keys needed.

# Execution mode: "sim" (paper account on live prices, default) | "live"
RS_MODE=sim

# Live mode: Binance Agent OS MCP server (Agentic sub-account required)
RS_MCP_URL=https://agent.binance.com/mcp/agentic
# Optional pre-issued Bearer token; leave empty to use interactive OAuth
# (the SDK triggers Binance's consent flow on first connect)
RS_MCP_ACCESS_TOKEN=

# ── Liquidation risk zones (distance from price to liq) ────────────────────
RS_LIQ_WARN_PCT=0.10         # below this = WATCH
RS_LIQ_DANGER_PCT=0.06       # below this = DANGER -> de-risk proposed
RS_LIQ_TARGET_DIST_PCT=0.15  # de-risk until 15% headroom

# ── Guardrails (hard limits the agent can never cross) ─────────────────────
RS_SYMBOL_ALLOWLIST=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT   # empty = any symbol
RS_FEE_RATE=0.001            # simulated spot taker fee
RS_FUTURES_FEE_RATE=0.0004   # simulated USDⓈ-M taker fee

# ── App ──────────────────────────────────────────────────────────────────────
# API posture (B4): optional bearer token gating state-changing /api calls.
# Leave empty for the open demo posture; set it on any reachable deployment.
# Read-only GETs and the served UI stay open so the browser app keeps working.
RS_API_TOKEN=
# CORS: comma-separated origins allowed to call the API cross-origin.
# Empty = same-origin only (browsers refuse cross-site calls). Example:
# RS_CORS_ORIGINS=https://guard.example
RS_CORS_ORIGINS=
RS_INITIAL_CASH=10000
RS_MARKET_BASE_URL=https://data-api.binance.vision
RS_STATE_FILE=data/sim_state.json

# ── Optional LLM narration (works with OpenAI, Groq, OpenRouter, …) ─────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
RS_NARRATION_LLM=false
